{
  "mcpServers": {
    "firebase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@latest",
        "mcp"
      ]
    },
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "play-store": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-jar",
        "${PLAY_STORE_MCP_JAR}"
      ],
      "env": {
        "PLAY_STORE_SERVICE_ACCOUNT_KEY_PATH": "${PLAY_STORE_SERVICE_ACCOUNT_KEY_PATH}"
      }
    }
  }
}
